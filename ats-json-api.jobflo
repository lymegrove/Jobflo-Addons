{
  "id": "com.jobflo.addon.ats-json-api",
  "displayName": "ATS JSON API (Greenhouse & Lever)",
  "description": "Parses the raw JSON response from Greenhouse's or Lever's public job board API (detected automatically) into normalized jobs, all in one pass.",
  "category": "utilities",
  "apiVersion": 1,
  "author": "jsrothwell",
  "version": "1.0.0",
  "minAppVersion": "2.4.0",
  "source": "// Parser addon — ported from the community registry's TypeScript source\n// (ats-json-api), which was built against an SDK this app can't install.\n// Same extraction logic, re-expressed against this app's real parser-addon\n// contract: a plain `parseJob(rawContent, sourceType, timestamp)` entry\n// point, no `JobFlo` bridge (parser addons get no app data access at all).\n//\n// Reads the raw JSON that Greenhouse's or Lever's public job board APIs\n// return (e.g. https://boards-api.greenhouse.io/v1/boards/<company>/jobs?content=true\n// or https://api.lever.co/v0/postings/<company>), auto-detects which shape\n// it is, and can return many parsed jobs from a single paste.\n//\n// Note: unlike the original TS addon, this contract has no `payload.metadata`\n// input, so a Lever response's company name (which Lever's API never embeds\n// directly) is derived only from the posting's own hostedUrl/applyUrl slug;\n// an entry that can't resolve a company that way is skipped with a non-fatal\n// error rather than aborting the batch.\n\nvar metadata = {\n  id: \"com.jobflo.addon.ats-json-api\",\n  displayName: \"ATS JSON API (Greenhouse & Lever)\",\n  description: \"Parses the raw JSON response from Greenhouse's or Lever's public job board API (detected automatically) into normalized jobs, all in one pass.\",\n  category: \"utilities\",\n  apiVersion: 1,\n  kind: \"parser\",\n  inputHint: \"json\",\n};\n\nvar HTML_ENTITIES = { \"&amp;\": \"&\", \"&lt;\": \"<\", \"&gt;\": \">\", \"&quot;\": '\"', \"&#39;\": \"'\", \"&apos;\": \"'\", \"&nbsp;\": \" \" };\n\nfunction decodeHtmlEntities(text) {\n  return text.replace(/&[a-zA-Z#0-9]+;/g, function (entity) { return HTML_ENTITIES[entity] || entity; });\n}\n\nfunction stripHtmlTags(text) {\n  return text.replace(/<[^>]+>/g, \" \").replace(/\\s+/g, \" \").trim();\n}\n\n// Greenhouse's `content` field HTML-escapes its own markup, so entities\n// must be decoded first to reveal the real tags before those tags can be\n// stripped — the reverse order from ordinary HTML.\nfunction plainTextFromGreenhouseContent(raw) {\n  return stripHtmlTags(decodeHtmlEntities(raw));\n}\n\n// Lever's list content is ordinary HTML (real tags, literal entities).\nfunction plainTextFromLeverHtml(raw) {\n  return decodeHtmlEntities(stripHtmlTags(raw));\n}\n\n// Best-effort company name from a jobs.lever.co/<slug>/... URL. Not authoritative.\nfunction companyFromLeverUrl(url) {\n  if (!url) return undefined;\n  var match = /jobs\\.lever\\.co\\/([^/]+)/i.exec(url);\n  var slug = match ? match[1] : undefined;\n  if (!slug) return undefined;\n  return slug\n    .split(/[-_]+/)\n    .filter(function (p) { return p.length > 0; })\n    .map(function (part) { return part.charAt(0).toUpperCase() + part.slice(1); })\n    .join(\" \");\n}\n\nfunction detectFormat(parsed) {\n  if (Array.isArray(parsed)) return \"lever\";\n  if (parsed && typeof parsed === \"object\" && Array.isArray(parsed[\"jobs\"])) return \"greenhouse\";\n  return undefined;\n}\n\nfunction mapGreenhouseJob(entry) {\n  var title = typeof entry[\"title\"] === \"string\" ? entry[\"title\"].trim() : undefined;\n  var company = typeof entry[\"company_name\"] === \"string\" ? entry[\"company_name\"].trim() : undefined;\n  if (!title || !company) return undefined;\n\n  var job = { title: title, company: company };\n\n  var location = entry[\"location\"];\n  if (location && typeof location === \"object\") {\n    var locName = location[\"name\"];\n    if (typeof locName === \"string\" && locName.trim()) job.location = locName.trim();\n  }\n\n  var descriptionParts = [];\n  var content = entry[\"content\"];\n  if (typeof content === \"string\" && content.trim()) descriptionParts.push(plainTextFromGreenhouseContent(content));\n\n  var departments = entry[\"departments\"];\n  if (Array.isArray(departments) && departments[0] && typeof departments[0] === \"object\") {\n    var deptName = departments[0][\"name\"];\n    if (typeof deptName === \"string\" && deptName.trim()) descriptionParts.push(\"Department: \" + deptName.trim());\n  }\n\n  var offices = entry[\"offices\"];\n  if (Array.isArray(offices) && offices[0] && typeof offices[0] === \"object\") {\n    var officeName = offices[0][\"name\"];\n    if (typeof officeName === \"string\" && officeName.trim()) descriptionParts.push(\"Office: \" + officeName.trim());\n  }\n\n  if (descriptionParts.length > 0) job.description = descriptionParts.join(\"\\n\\n\");\n\n  var url = entry[\"absolute_url\"];\n  if (typeof url === \"string\" && url.trim()) job.url = url.trim();\n\n  return job;\n}\n\nfunction mapLeverJob(entry) {\n  var title = typeof entry[\"text\"] === \"string\" ? entry[\"text\"].trim() : undefined;\n  var hostedUrl = typeof entry[\"hostedUrl\"] === \"string\" ? entry[\"hostedUrl\"] : undefined;\n  var company = companyFromLeverUrl(hostedUrl) || companyFromLeverUrl(entry[\"applyUrl\"]);\n  if (!title || !company) return undefined;\n\n  var job = { title: title, company: company };\n  if (hostedUrl) job.url = hostedUrl;\n\n  var descriptionParts = [];\n\n  var categories = entry[\"categories\"];\n  if (categories && typeof categories === \"object\") {\n    if (typeof categories[\"location\"] === \"string\" && categories[\"location\"].trim()) job.location = categories[\"location\"].trim();\n    if (typeof categories[\"team\"] === \"string\" && categories[\"team\"].trim()) descriptionParts.push(\"Team: \" + categories[\"team\"].trim());\n    if (typeof categories[\"commitment\"] === \"string\" && categories[\"commitment\"].trim()) descriptionParts.push(\"Commitment: \" + categories[\"commitment\"].trim());\n  }\n\n  if (typeof entry[\"workplaceType\"] === \"string\" && entry[\"workplaceType\"].trim()) {\n    descriptionParts.push(\"Workplace: \" + entry[\"workplaceType\"].trim());\n  }\n\n  var bodyParts = [];\n  var plainKeys = [\"openingPlain\", \"descriptionPlain\", \"descriptionBodyPlain\"];\n  for (var k = 0; k < plainKeys.length; k++) {\n    var value = entry[plainKeys[k]];\n    if (typeof value === \"string\" && value.trim()) bodyParts.push(value.trim());\n  }\n  var lists = entry[\"lists\"];\n  if (Array.isArray(lists)) {\n    for (var item of lists) {\n      if (!item || typeof item !== \"object\") continue;\n      var heading = item[\"text\"];\n      var content = item[\"content\"];\n      var body = typeof content === \"string\" ? plainTextFromLeverHtml(content) : \"\";\n      if (typeof heading === \"string\" && heading.trim() && body) {\n        bodyParts.push(heading.trim() + \"\\n\" + body);\n      } else if (body) {\n        bodyParts.push(body);\n      }\n    }\n  }\n  var additionalPlain = entry[\"additionalPlain\"];\n  if (typeof additionalPlain === \"string\" && additionalPlain.trim()) bodyParts.push(additionalPlain.trim());\n\n  var allParts = descriptionParts.concat(bodyParts);\n  if (allParts.length > 0) job.description = allParts.join(\"\\n\\n\");\n\n  return job;\n}\n\nfunction parseJob(rawContent, sourceType, timestamp) {\n  var parsedJobs = [];\n  var errors = [];\n\n  var raw = rawContent.trim();\n  if (!raw) {\n    errors.push({ message: \"Input is empty\", code: \"NO_CONTENT\" });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var parsed;\n  try {\n    parsed = JSON.parse(raw);\n  } catch (error) {\n    errors.push({\n      message: \"Input is not valid JSON. Paste the raw response body from a boards-api.greenhouse.io/v1/boards/<company>/jobs or api.lever.co/v0/postings/<company> request.\",\n      code: \"INVALID_JSON\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var format = detectFormat(parsed);\n  if (!format) {\n    errors.push({\n      message: 'Could not recognize this as a Greenhouse (\"{ jobs: [...] }\") or Lever (\"[...]\") job board API response.',\n      code: \"UNRECOGNIZED_SHAPE\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var entries = format === \"greenhouse\" ? parsed[\"jobs\"] : parsed;\n\n  for (var i = 0; i < entries.length; i++) {\n    var entry = entries[i];\n    if (!entry || typeof entry !== \"object\") {\n      errors.push({ message: \"Entry at index \" + i + \" is not an object\", code: \"INVALID_ENTRY\" });\n      continue;\n    }\n\n    var job = format === \"greenhouse\" ? mapGreenhouseJob(entry) : mapLeverJob(entry);\n\n    if (!job) {\n      errors.push({\n        message: \"Entry at index \" + i + \" is missing a title\" + (format === \"lever\" ? \" or a resolvable company\" : \" or company_name\") + \" and was skipped\",\n        code: \"INCOMPLETE_JOB_ENTRY\",\n      });\n      continue;\n    }\n\n    parsedJobs.push(job);\n  }\n\n  return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n}\n",
  "kind": "parser",
  "inputHint": "json"
}
