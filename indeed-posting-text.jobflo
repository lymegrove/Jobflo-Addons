{
  "id": "com.jobflo.addon.indeed-posting-text",
  "displayName": "Indeed Posting Text",
  "description": "Parses the plain text of an Indeed job posting's detail panel (title, company, location, and Full job description) into a normalized job.",
  "category": "utilities",
  "apiVersion": 1,
  "author": "jsrothwell",
  "version": "1.0.0",
  "minAppVersion": "2.4.0",
  "source": "// Parser addon — ported from the community registry's TypeScript source\n// (indeed-posting-text), which was built against an SDK this app can't\n// install. Same extraction logic, re-expressed against this app's real\n// parser-addon contract: a plain `parseJob(rawContent, sourceType,\n// timestamp)` entry point, no `JobFlo` bridge (parser addons get no app\n// data access at all).\n//\n// Works from the plain text of an Indeed job posting's detail panel as a\n// person would select and copy it — Indeed doesn't expose structured job\n// data to a logged-out request. The panel's shape varies (whether a\n// company rating, a salary, and a \"Job details\" block appear depends on\n// the listing), so this parser anchors on the one heading present on\n// essentially every posting (\"Full job description\") and fails clearly\n// rather than guessing when the header above it doesn't resolve to a\n// title and company. Expected paste, in order:\n//\n//   [Job Post Details]                        (panel label, optional)\n//   Title\n//   [- job post]                              (suffix, optional, own line)\n//   Company\n//   [(part of Parent Co)]                     (optional)\n//   [N.N]\n//   [N.N out of 5 stars]                      (rating, optional)\n//   Location\n//   [$X - $Y a year - Full-time]              (inline salary + type)\n//     -- or --\n//   [Job details\n//    Pay\n//    $X - $Y a year\n//    Job type\n//    Full-time]                               (block form, optional)\n//   [Apply on company site | Easily apply | Save job | Share Job | ...]\n//   Full job description\n//   <description>\n//   [Report job | Explore other jobs]         (Indeed's own cutoffs)\n//   ...\n\nvar metadata = {\n  id: \"com.jobflo.addon.indeed-posting-text\",\n  displayName: \"Indeed Posting Text\",\n  description: \"Parses the plain text of an Indeed job posting's detail panel (title, company, location, and Full job description) into a normalized job.\",\n  category: \"utilities\",\n  apiVersion: 1,\n  kind: \"parser\",\n  inputHint: \"plainText\",\n};\n\nvar DESCRIPTION_START_RE = /^full job description$/i;\nvar DESCRIPTION_STOP_LINES = [\"report job\", \"explore other jobs\", \"return to search result\"];\nvar HEADER_NOISE_RE = /^(job post details|job details|easily apply|save job|saved|share job|apply on .*|you must .*)$/i;\nvar JOB_POST_SUFFIX_LINE_RE = /^-\\s*job post$/i;\nvar TITLE_SUFFIX_RE = /\\s*-\\s*job post\\s*$/i;\nvar RATING_LINE_RE = /^\\d(?:\\.\\d)?$/;\nvar RATING_STARS_RE = /^\\d(?:\\.\\d)?\\s+out of 5 stars$/i;\nvar PARENTHETICAL_ONLY_RE = /^\\(.+\\)$/;\nvar EMPLOYMENT_TYPES = [\"Full-time\", \"Part-time\", \"Contract\", \"Temporary\", \"Internship\", \"Per diem\", \"Seasonal\"];\nvar PAY_LABEL_RE = /^pay$/i;\nvar JOB_TYPE_LABEL_RE = /^job type$/i;\nvar SALARY_TEXT_RE = /\\$[\\d,]+(?:\\.\\d+)?\\s*(?:-|to)\\s*\\$?[\\d,]+(?:\\.\\d+)?\\s*(?:an?\\s+(?:hour|year|month|week|day))/i;\n\nfunction parseJob(rawContent, sourceType, timestamp) {\n  var parsedJobs = [];\n  var errors = [];\n\n  var allLines = rawContent.split(/\\r?\\n/).map(function (l) { return l.trim(); });\n\n  if (allLines.every(function (l) { return l.length === 0; })) {\n    errors.push({ message: \"Input is empty\", code: \"NO_CONTENT\" });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var descriptionStartIndex = allLines.findIndex(function (l) { return DESCRIPTION_START_RE.test(l); });\n\n  if (descriptionStartIndex === -1) {\n    errors.push({\n      message: 'Could not find the \"Full job description\" heading. Paste the job\\'s detail panel starting from the title and including the Full job description section.',\n      code: \"NO_DESCRIPTION_MARKER\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  // --- Header region: everything before \"Full job description\" ---\n  var headerLines = allLines.slice(0, descriptionStartIndex).filter(function (l) {\n    return (\n      l.length > 0 &&\n      !HEADER_NOISE_RE.test(l) &&\n      !JOB_POST_SUFFIX_LINE_RE.test(l) &&\n      !RATING_LINE_RE.test(l) &&\n      !RATING_STARS_RE.test(l) &&\n      !PARENTHETICAL_ONLY_RE.test(l)\n    );\n  });\n\n  var identityLines = [];\n\n  for (var i = 0; i < headerLines.length; i++) {\n    var line = headerLines[i];\n\n    if (PAY_LABEL_RE.test(line)) {\n      if (headerLines[i + 1]) i++;\n      continue;\n    }\n    if (JOB_TYPE_LABEL_RE.test(line)) {\n      if (headerLines[i + 1]) i++;\n      continue;\n    }\n\n    var salaryMatch = SALARY_TEXT_RE.exec(line);\n    if (salaryMatch) {\n      // Inline form: \"$120,000 - $160,000 a year - Full-time\" — salary/type\n      // aren't part of ParsedJobResult, so this line is just consumed.\n      continue;\n    }\n\n    var employmentMatch = EMPLOYMENT_TYPES.find(function (t) { return t.toLowerCase() === line.toLowerCase(); });\n    if (employmentMatch) {\n      continue;\n    }\n\n    identityLines.push(line);\n  }\n\n  var rawTitle = identityLines[0];\n  var title = rawTitle ? rawTitle.replace(TITLE_SUFFIX_RE, \"\").trim() : rawTitle;\n  var company = identityLines[1];\n  var location = identityLines[2];\n\n  if (!title || !company) {\n    errors.push({\n      message: 'Could not identify both a title and a company above \"Full job description\". Expected the first two non-badge lines of the pasted panel to be the job title and the company name.',\n      code: \"INCOMPLETE_HEADER\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var job = { title: title, company: company };\n  if (location) job.location = location;\n\n  // --- Body region: everything after \"Full job description\", truncated at Indeed's own cutoffs ---\n  var bodyAllLines = allLines.slice(descriptionStartIndex + 1);\n  var stopIndex = bodyAllLines.findIndex(function (l) { return DESCRIPTION_STOP_LINES.indexOf(l.toLowerCase()) !== -1; });\n  if (stopIndex === -1) stopIndex = bodyAllLines.length;\n\n  var description = bodyAllLines\n    .slice(0, stopIndex)\n    .join(\"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n\n  if (description) job.description = description;\n\n  parsedJobs.push(job);\n\n  return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n}\n",
  "kind": "parser",
  "inputHint": "plainText"
}
