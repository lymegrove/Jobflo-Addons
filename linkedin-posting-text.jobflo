{
  "id": "com.jobflo.addon.linkedin-posting-text",
  "displayName": "LinkedIn Posting Text",
  "description": "Parses the plain text of a LinkedIn job posting's detail panel (company, title, location, badges, and About the job) into a normalized job.",
  "category": "utilities",
  "apiVersion": 1,
  "author": "jsrothwell",
  "version": "1.0.0",
  "minAppVersion": "2.4.0",
  "source": "// Parser addon — ported from the community registry's TypeScript source\n// (linkedin-posting-text), which was built against an SDK this app can't\n// install. Same extraction logic, re-expressed against this app's real\n// parser-addon contract: a plain `parseJob(rawContent, sourceType,\n// timestamp)` entry point, no `JobFlo` bridge (parser addons get no app\n// data access at all).\n//\n// LinkedIn doesn't expose structured job data to a logged-out request, so\n// this works from the plain text a person gets selecting a job's detail\n// panel and copying it. That text has no format guarantee, so this parser\n// is deliberately conservative: it anchors on the one heading that's\n// present on essentially every posting (\"About the job\") and on a small\n// set of literal UI strings, and it fails clearly (via an error) rather\n// than guessing when the shape doesn't match. Expected paste, in order:\n//\n//   Company\n//   Title\n//   Location · [Reposted] N <unit> ago · N applicants  (or \"Over N people clicked apply\")\n//   [Promoted by hirer · Responses managed off LinkedIn]   (sponsored postings only)\n//   Remote | On-site | Hybrid\n//   Full-time | Part-time | Contract | ...\n//   Apply\n//   Save\n//   About the job\n//   <description>\n//   Benefits found in job post                              (LinkedIn's own cutoff)\n//   ...\n//\n// Note: unlike the original TS addon, `ParsedJobResult` has no field for a\n// posting's relative \"posted N days ago\" timestamp — nothing downstream\n// has a home for it — so that part of the header is recognized (to keep it\n// out of the identity lines) and then dropped rather than carried through.\n\nvar metadata = {\n  id: \"com.jobflo.addon.linkedin-posting-text\",\n  displayName: \"LinkedIn Posting Text\",\n  description: \"Parses the plain text of a LinkedIn job posting's detail panel (company, title, location, badges, and About the job) into a normalized job.\",\n  category: \"utilities\",\n  apiVersion: 1,\n  kind: \"parser\",\n  inputHint: \"plainText\",\n};\n\nvar DESCRIPTION_START_RE = /^about the (job|role)$/i;\nvar DESCRIPTION_STOP_LINES = [\n  \"benefits found in job post\",\n  \"about the company\",\n  \"see how you compare to others who clicked apply\",\n  \"show premium insights\",\n  \"exclusive job seeker insights\",\n  \"candidate seniority level\",\n  \"candidates who clicked apply\",\n  \"how your profile and resume are aligned with this job\",\n  \"people also viewed\",\n  \"meet the hiring team\",\n  \"set alert for similar jobs\",\n];\nvar HEADER_NOISE_LINES = [\"apply\", \"save\", \"saved\", \"easy apply\", \"follow\", \"following\", \"use ai to assess how you fit\"];\nvar HEADER_NOISE_RE = /promoted by hirer|responses managed off linkedin/i;\nvar WORKPLACE_TYPES = [\"On-site\", \"Remote\", \"Hybrid\"];\nvar EMPLOYMENT_TYPES = [\"Full-time\", \"Part-time\", \"Contract\", \"Temporary\", \"Internship\", \"Volunteer\", \"Other\"];\nvar RELATIVE_AGO_RE = /^(\\d+)\\s*(minute|hour|day|week|month|year)s?\\s+ago$/i;\nvar APPLICANT_COUNT_RE = /^(?:over\\s+)?([\\d,]+)\\+?\\s*(?:people clicked apply|applicants?)$/i;\nvar EARLY_APPLICANT_RE = /^be an early applicant$/i;\n\n/** Splits \"Toronto, ON · Reposted 5 days ago · Over 100 people clicked apply\" into its parts. */\nfunction parseMetaLine(line) {\n  var segments = line.split(\"·\").map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });\n  if (segments.length === 0) return {};\n\n  var info = { location: segments[0] };\n\n  for (var i = 1; i < segments.length; i++) {\n    var segment = segments[i];\n    if (APPLICANT_COUNT_RE.test(segment) || EARLY_APPLICANT_RE.test(segment) || RELATIVE_AGO_RE.test(segment.replace(/^(?:re)?posted\\s+/i, \"\")) || /^(just now|today|yesterday)$/i.test(segment)) {\n      continue;\n    }\n  }\n\n  return info;\n}\n\nfunction parseJob(rawContent, sourceType, timestamp) {\n  var parsedJobs = [];\n  var errors = [];\n\n  var allLines = rawContent.split(/\\r?\\n/).map(function (l) { return l.trim(); });\n\n  if (allLines.every(function (l) { return l.length === 0; })) {\n    errors.push({ message: \"Input is empty\", code: \"NO_CONTENT\" });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var descriptionStartIndex = allLines.findIndex(function (l) { return DESCRIPTION_START_RE.test(l); });\n\n  if (descriptionStartIndex === -1) {\n    errors.push({\n      message: 'Could not find the \"About the job\" heading. Paste the job\\'s detail panel starting from the company name and including the About the job section.',\n      code: \"NO_DESCRIPTION_MARKER\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  // --- Header region: everything before \"About the job\" ---\n  var headerLines = allLines.slice(0, descriptionStartIndex).filter(function (l) {\n    return l.length > 0 && !HEADER_NOISE_RE.test(l) && HEADER_NOISE_LINES.indexOf(l.toLowerCase()) === -1;\n  });\n\n  var workplaceType;\n  var meta = {};\n  var identityLines = [];\n\n  for (var i = 0; i < headerLines.length; i++) {\n    var line = headerLines[i];\n\n    var workplaceMatch = WORKPLACE_TYPES.find(function (t) { return t.toLowerCase() === line.toLowerCase(); });\n    if (workplaceMatch) {\n      workplaceType = workplaceMatch;\n      continue;\n    }\n    var employmentMatch = EMPLOYMENT_TYPES.find(function (t) { return t.toLowerCase() === line.toLowerCase(); });\n    if (employmentMatch) {\n      continue;\n    }\n    if (line.indexOf(\"·\") !== -1 && !meta.location) {\n      meta = parseMetaLine(line);\n      continue;\n    }\n    identityLines.push(line);\n  }\n\n  var company = identityLines[0];\n  var title = identityLines[1];\n\n  if (!title || !company) {\n    errors.push({\n      message: 'Could not identify both a company and a job title above \"About the job\". Expected the first two lines of the pasted panel to be the company name and the job title.',\n      code: \"INCOMPLETE_HEADER\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var job = { title: title, company: company };\n\n  if (meta.location) {\n    job.location = workplaceType ? meta.location + \" (\" + workplaceType + \")\" : meta.location;\n  } else if (workplaceType) {\n    job.location = workplaceType;\n  }\n\n  // --- Body region: everything after \"About the job\", truncated at LinkedIn's own cutoffs ---\n  var bodyAllLines = allLines.slice(descriptionStartIndex + 1);\n  var stopIndex = bodyAllLines.findIndex(function (l) { return DESCRIPTION_STOP_LINES.indexOf(l.toLowerCase()) !== -1; });\n  if (stopIndex === -1) stopIndex = bodyAllLines.length;\n\n  var description = bodyAllLines\n    .slice(0, stopIndex)\n    .join(\"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n\n  if (description) job.description = description;\n\n  parsedJobs.push(job);\n\n  return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n}\n",
  "kind": "parser",
  "inputHint": "plainText"
}
