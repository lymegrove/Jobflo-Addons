{
  "id": "com.jobflo.addon.schema-org-jobposting",
  "displayName": "schema.org JobPosting",
  "description": "Extracts schema.org JobPosting JSON-LD from pasted job page HTML.",
  "category": "utilities",
  "apiVersion": 1,
  "author": "jsrothwell",
  "version": "1.0.0",
  "minAppVersion": "2.4.0",
  "source": "// Parser addon — ported from the community registry's TypeScript source\n// (schema-org-jobposting), which was built against an SDK this app can't\n// install. Same extraction logic, re-expressed against this app's real\n// parser-addon contract: a plain `parseJob(rawContent, sourceType,\n// timestamp)` entry point, no `JobFlo` bridge (parser addons get no app\n// data access at all).\n//\n// Feed it the HTML source of a job posting page — most ATS platforms\n// (Greenhouse, Lever, Workday, SmartRecruiters, LinkedIn, Indeed, and many\n// company career pages) embed a JobPosting JSON-LD block purely for\n// search-engine rich results, and it's already a normalized job record.\n\nvar metadata = {\n  id: \"com.jobflo.addon.schema-org-jobposting\",\n  displayName: \"schema.org JobPosting\",\n  description: \"Extracts schema.org JobPosting JSON-LD from pasted job page HTML.\",\n  category: \"utilities\",\n  apiVersion: 1,\n  kind: \"parser\",\n  inputHint: \"html\",\n};\n\nvar JSON_LD_SCRIPT_RE = /<script[^>]*\\btype\\s*=\\s*[\"']application\\/ld\\+json[\"'][^>]*>([\\s\\S]*?)<\\/script>/gi;\nvar MAX_WALK_DEPTH = 25;\n\nfunction extractJsonLdBlocks(html) {\n  var blocks = [];\n  var matches = html.matchAll(JSON_LD_SCRIPT_RE);\n  for (var match of matches) {\n    var raw = match[1] ? match[1].trim() : \"\";\n    if (raw) blocks.push(raw);\n  }\n  return blocks;\n}\n\nfunction hasJobPostingType(node) {\n  var type = node[\"@type\"];\n  if (typeof type === \"string\") return type === \"JobPosting\";\n  if (Array.isArray(type)) return type.some(function (t) { return t === \"JobPosting\"; });\n  return false;\n}\n\nfunction collectJobPostings(value, results, depth) {\n  depth = depth || 0;\n  if (depth > MAX_WALK_DEPTH || value === null || value === undefined) return;\n\n  if (Array.isArray(value)) {\n    for (var item of value) collectJobPostings(item, results, depth + 1);\n    return;\n  }\n  if (typeof value !== \"object\") return;\n\n  if (hasJobPostingType(value)) results.push(value);\n\n  for (var key of Object.keys(value)) collectJobPostings(value[key], results, depth + 1);\n}\n\nfunction extractName(value) {\n  if (typeof value === \"string\" && value.trim()) return value.trim();\n  if (Array.isArray(value)) {\n    for (var item of value) {\n      var name = extractName(item);\n      if (name) return name;\n    }\n    return undefined;\n  }\n  if (value && typeof value === \"object\") {\n    var name = value[\"name\"];\n    if (typeof name === \"string\" && name.trim()) return name.trim();\n  }\n  return undefined;\n}\n\nfunction extractCompany(node) {\n  return extractName(node[\"hiringOrganization\"]);\n}\n\nfunction formatAddress(address) {\n  if (typeof address === \"string\" && address.trim()) return address.trim();\n  if (address && typeof address === \"object\") {\n    var parts = [address[\"addressLocality\"], address[\"addressRegion\"], address[\"addressCountry\"]]\n      .filter(function (p) { return typeof p === \"string\" && p.trim().length > 0; })\n      .map(function (p) { return p.trim(); });\n    return parts.length > 0 ? parts.join(\", \") : undefined;\n  }\n  return undefined;\n}\n\nfunction extractLocation(node) {\n  var jobLocationType = node[\"jobLocationType\"];\n  var jobLocation = node[\"jobLocation\"];\n  var locations = [];\n  var places = Array.isArray(jobLocation) ? jobLocation : (jobLocation ? [jobLocation] : []);\n\n  for (var place of places) {\n    if (place && typeof place === \"object\") {\n      var formatted = formatAddress(place[\"address\"] || place);\n      if (formatted && locations.indexOf(formatted) === -1) locations.push(formatted);\n    } else if (typeof place === \"string\" && place.trim()) {\n      locations.push(place.trim());\n    }\n  }\n\n  if (locations.length > 0) return locations.join(\"; \");\n  if (typeof jobLocationType === \"string\" && jobLocationType.toUpperCase() === \"TELECOMMUTE\") return \"Remote\";\n  return undefined;\n}\n\nvar HTML_ENTITIES = { \"&amp;\": \"&\", \"&lt;\": \"<\", \"&gt;\": \">\", \"&quot;\": '\"', \"&#39;\": \"'\", \"&apos;\": \"'\", \"&nbsp;\": \" \" };\n\nfunction stripHtml(html) {\n  return html\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/&[a-zA-Z#0-9]+;/g, function (entity) { return HTML_ENTITIES[entity] || entity; })\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction parseJob(rawContent, sourceType, timestamp) {\n  var parsedJobs = [];\n  var errors = [];\n\n  var blocks = extractJsonLdBlocks(rawContent);\n  if (blocks.length === 0) {\n    errors.push({\n      message: \"No JSON-LD found. Paste the full HTML source of the job page.\",\n      code: \"NO_JSON_LD\",\n    });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  var jobPostingNodes = [];\n  for (var i = 0; i < blocks.length; i++) {\n    var value;\n    try {\n      value = JSON.parse(blocks[i]);\n    } catch (error) {\n      errors.push({ message: \"JSON-LD block \" + (i + 1) + \" is not valid JSON\", code: \"MALFORMED_JSON_LD\" });\n      continue;\n    }\n    collectJobPostings(value, jobPostingNodes);\n  }\n\n  if (jobPostingNodes.length === 0) {\n    errors.push({ message: \"No JobPosting entries found in the page's JSON-LD\", code: \"NO_JOBPOSTING_FOUND\" });\n    return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n  }\n\n  for (var j = 0; j < jobPostingNodes.length; j++) {\n    var node = jobPostingNodes[j];\n    var title = typeof node[\"title\"] === \"string\" ? node[\"title\"].trim() : \"\";\n    var company = extractCompany(node);\n\n    if (!title || !company) {\n      errors.push({ message: \"JobPosting \" + (j + 1) + \" is missing a required title or hiringOrganization\", code: \"INCOMPLETE_JOBPOSTING\" });\n      continue;\n    }\n\n    var job = { title: title, company: company };\n    var location = extractLocation(node);\n    if (location) job.location = location;\n    var description = typeof node[\"description\"] === \"string\" ? stripHtml(node[\"description\"]) : undefined;\n    if (description) job.description = description;\n    var url = typeof node[\"url\"] === \"string\" && node[\"url\"].trim() ? node[\"url\"].trim() : undefined;\n    if (url) job.url = url;\n\n    parsedJobs.push(job);\n  }\n\n  return { apiVersion: 1, parsedJobs: parsedJobs, errors: errors };\n}\n",
  "kind": "parser",
  "inputHint": "html"
}
